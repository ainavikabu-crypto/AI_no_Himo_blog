    {
      "id": "66086876-4b49-45fe-aecc-f7f062a59dba",
      "name": "リンククリーンアップ",
      "type": "n8n-nodes-base.set",
      "position": [-1660, 560],
      "parameters": {
        "options": {},
        "assignments": {
          "assignments": [
            {
              "id": "23b8e8c4-9191-415a-9661-1b60d413528a",
