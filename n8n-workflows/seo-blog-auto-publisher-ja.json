    {
      "id": "8a3739ac-9492-400c-b5b8-eeb305647752",
      "name": "構造化出力パーサー",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [-680, 820],
      "parameters": {
        "jsonSchemaExample": "{\n\"slug\": \"ai-workflow-automation-guide\",\n\"title\": \"AI活用で業務効率化を実現する7つの方法\",\n\"meta\": \"AIとワークフロー自動化で業務効率を大幅に向上させる方法を、実例とともに詳しく解説します。\"\n}"
